{
  "name": "lectern-notes",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.json *.html *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pdfjs-dist": "^4.10.38",
    "pdf-lib": "^1.17.1",
    "idb": "^8.0.3",
    "core-js": "^3.47.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "prettier": "^3.6.2",
    "@playwright/test": "^1.56.1"
  }
}
